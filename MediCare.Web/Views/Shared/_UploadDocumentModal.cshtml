@model UploadDocumentViewModel
@*
    Upload dialog used by the doctor and patient Medical Records pages.
    ViewData["UploadAction"]: form URL. ViewData["UploadPatients"]: patient list (doctor only; null for patients).
*@
@{
    var action = ViewData["UploadAction"] as string ?? "";
    var patients = ViewData["UploadPatients"] as IReadOnlyList<PatientOption>;
    var types = Enum.GetValues<DocumentType>();
}
<div class="modal fade" id="mrUploadModal" tabindex="-1" aria-labelledby="mrUploadTitle" aria-hidden="true"
     data-mr-autoshow="@(ViewData["OpenUploadModal"] is true ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content mr-modal" method="post" action="@action" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Upload.ReturnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="Upload.MedicalRecordId" value="@Model.MedicalRecordId" />

            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title h6 fw-bold" id="mrUploadTitle"><i class="bi bi-upload me-2"></i>Upload a file</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                @if (patients is not null)
                {
                    <div class="mb-3">
                        <label class="form-label small" for="Upload_PatientId">Patient</label>
                        <select class="form-select mr-input" id="Upload_PatientId" name="Upload.PatientId" required>
                            <option value="">Choose a patient...</option>
                            @foreach (var p in patients)
                            {
                                <option value="@p.Id" selected="@(Model.PatientId == p.Id)">@p.Name</option>
                            }
                        </select>
                        <span class="text-danger small">@Html.ValidationMessage("Upload.PatientId")</span>
                    </div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-sm-7">
                        <label class="form-label small" for="Upload_Title">Title <span class="mr-muted">(optional)</span></label>
                        <input class="form-control mr-input" id="Upload_Title" name="Upload.Title" value="@Model.Title" maxlength="200" placeholder="e.g. Chest X-ray" />
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label small" for="Upload_DocumentType">Type</label>
                        <select class="form-select mr-input" id="Upload_DocumentType" name="Upload.DocumentType">
                            @foreach (var t in types)
                            {
                                <option value="@t" selected="@(Model.DocumentType == t)">@t</option>
                            }
                        </select>
                    </div>
                </div>

                <label class="mr-dropzone" for="Upload_File">
                    <i class="bi bi-cloud-arrow-up"></i>
                    <span class="fw-semibold" data-mr-file-label>Choose a file or drag it here</span>
                    <span class="mr-muted small">PDF, JPG, PNG or DICOM &middot; up to 10 MB</span>
                    <input type="file" id="Upload_File" name="Upload.File" accept=".pdf,.jpg,.jpeg,.png,.dcm" required class="visually-hidden" />
                </label>
                <span class="text-danger small d-block mt-2">@Html.ValidationMessage("Upload.File")</span>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn mr-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn mr-btn-primary"><i class="bi bi-upload me-1"></i>Upload</button>
            </div>
        </form>
    </div>
</div>
