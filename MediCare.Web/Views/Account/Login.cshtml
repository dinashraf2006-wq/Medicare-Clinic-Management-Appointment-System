namespace MediCare.Web.Views.Account
{
    public class Login
    {
    }
}

@model MediCare.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container-fluid min-vh-100 d-flex p-0">
    <!-- Left Banner Side -->
    <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-between p-5 text-white" style="background: linear-gradient(135deg, #0d3b66 0%, #001f3f 100%);">
        <div>
            <h3 class="fw-bold"><span class="text-info">♥</span> Shefa.</h3>
        </div>
        <div>
            <h1 class="display-5 fw-bold mb-3">Welcome back to better care.</h1>
            <p class="lead text-white-50 mb-4">Sign in to manage your appointments, prescriptions and medical records.</p>
            <ul class="list-unstyled text-white-50">
                <li class="mb-2">✔ 1,200+ verified doctors across Egypt</li>
                <li class="mb-2">✔ Book in-clinic or video visits in seconds</li>
                <li class="mb-2">✔ Your records, prescriptions & labs in one place</li>
            </ul>
        </div>
        <div class="card bg-white text-dark p-3 border-0 shadow-sm mt-4" style="max-width: 400px;">
            <p class="mb-1 fst-italic">"Booked a cardiologist in under a minute and had my results in the app the same day. Shefa made it effortless."</p>
            <small class="fw-bold text-muted">Mariam Adel - Patient, Cairo</small>
        </div>
    </div>

    <!-- Right Form Side -->
    <div class="col-lg-6 d-flex align-items-center justify-content-center p-4 bg-white">
        <div class="w-100" style="max-width: 420px;">
            <h2 class="fw-bold mb-1">Log in</h2>
            <p class="text-muted mb-4">Good to see you again. Choose your account type to continue.</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Role Selector Tabs -->
                <div class="btn-group w-100 mb-4 p-1 bg-light rounded-pill" role="group">
                    <input type="radio" class="btn-check" name="UserRole" id="rolePatient" value="Patient" checked>
                    <label class="btn rounded-pill fw-semibold" for="rolePatient">Patient</label>

                    <input type="radio" class="btn-check" name="UserRole" id="roleDoctor" value="Doctor">
                    <label class="btn rounded-pill fw-semibold" for="roleDoctor">Doctor</label>
                </div>

                <div class="mb-3">
                    <label asp-for="EmailOrPhone" class="form-label text-muted small fw-bold">Email or phone</label>
                    <input asp-for="EmailOrPhone" class="form-control rounded-3 p-3" placeholder="sara.ahmed@gmail.com" />
                    <span asp-validation-for="EmailOrPhone" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label text-muted small fw-bold">Password</label>
                    <input asp-for="Password" class="form-control rounded-3 p-3" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me</label>
                    </div>
                    <a href="#" class="text-decoration-none small fw-semibold text-primary">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-info w-100 py-3 rounded-pill text-white fw-bold shadow-sm" style="background-color: #00b4d8; border: none;">
                    Log in &rarr;
                </button>

                <div class="text-center mt-4">
                    <p class="text-muted small">New to Shefa? <a asp-action="Register" class="text-decoration-none fw-bold text-primary">Create an account</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
