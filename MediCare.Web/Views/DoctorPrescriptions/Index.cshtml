@model DoctorPrescriptionsViewModel
@{
    Layout = "_DoctorPortalLayout";
    ViewData["Title"] = "Prescriptions";
    ViewData["ActiveNav"] = "prescriptions";
    var form = Model.NewPrescription;
    var frequencies = Html.GetEnumSelectList<MedicationFrequency>();
}

<div class="mr-page-header">
    <div>
        <h1 class="mr-title">Prescriptions</h1>
        <p class="mr-subtitle">Write and track e-prescriptions.</p>
    </div>
    <div class="mr-page-actions">
        <form method="get" class="mr-search" role="search">
            <i class="bi bi-search"></i>
            <input type="search" name="q" value="@Model.Search" placeholder="Search..." aria-label="Search prescriptions" />
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <section class="mr-card">
            <h2 class="mr-card-title mb-3">Recent prescriptions</h2>
            @if (Model.Rows.Count == 0)
            {
                <div class="mr-empty">
                    <i class="bi bi-capsule"></i>
                    <p class="mb-1 fw-semibold">No prescriptions yet</p>
                    <p class="mr-muted small mb-0">Use the form to write your first one.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table mr-table align-middle mb-0">
                        <thead><tr><th>Patient</th><th>Medication</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var rx = row.Prescription;
                            var name = rx.Patient.User.FullName;
                            var firstMed = rx.Items.FirstOrDefault()?.MedicationName ?? "-";
                            var more = rx.Items.Count > 1 ? $" +{rx.Items.Count - 1}" : "";
                            <tr class="mr-row-link" data-href="/Doctor/Prescriptions/@rx.Id">
                                <td>
                                    <span class="mr-person">
                                        <span class="mr-avatar mr-avatar-xs" style="background:@MedicalRecordsDisplay.AvatarColor(name)">@MedicalRecordsDisplay.Initials(name)</span>
                                        <span class="fw-semibold">@name</span>
                                    </span>
                                </td>
                                <td><a class="mr-record-link" href="/Doctor/Prescriptions/@rx.Id">@firstMed<span class="mr-muted">@more</span></a></td>
                                <td class="mr-muted">@MedicalRecordsDisplay.FriendlyDate(rx.SentAt ?? rx.CreatedAt)</td>
                                <td><span class="mr-badge @MedicalRecordsDisplay.StatusBadgeClass(row.StatusLabel)">@row.StatusLabel</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="col-xl-5">
        <section class="mr-card" id="new-prescription">
            <h2 class="mr-card-title mb-3">New prescription</h2>

            <form method="post" action="/Doctor/Prescriptions" id="rxForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NewPrescription.MedicalRecordId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="NewPrescription.PatientId" class="form-label small"></label>
                    <select asp-for="NewPrescription.PatientId" class="form-select mr-input"
                            asp-items="@(new SelectList(Model.Patients, nameof(PatientOption.Id), nameof(PatientOption.Name)))">
                        <option value="">Choose a patient...</option>
                    </select>
                    <span asp-validation-for="NewPrescription.PatientId" class="text-danger small"></span>
                    @if (Model.LinkedVisitLabel is not null)
                    {
                        <div class="mr-muted small mt-1"><i class="bi bi-link-45deg"></i> Linked to visit: @Model.LinkedVisitLabel</div>
                    }
                </div>

                <div id="rxItems">
                    @for (var i = 0; i < form.Items.Count; i++)
                    {
                        <fieldset class="mr-rx-item" data-rx-item>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <legend class="mr-label mb-0" data-rx-number>Medication @(i + 1)</legend>
                                <button type="button" class="btn btn-sm mr-icon-link" data-rx-remove aria-label="Remove medication"><i class="bi bi-trash"></i></button>
                            </div>
                            <div class="row g-2">
                                <div class="col-7">
                                    <input asp-for="NewPrescription.Items[i].MedicationName" class="form-control mr-input" placeholder="Medication (e.g. Amlodipine 5mg)" />
                                    <span asp-validation-for="NewPrescription.Items[i].MedicationName" class="text-danger small"></span>
                                </div>
                                <div class="col-5">
                                    <input asp-for="NewPrescription.Items[i].Indication" class="form-control mr-input" placeholder="Used for" />
                                </div>
                                <div class="col-6">
                                    <label asp-for="NewPrescription.Items[i].Dose" class="form-label small mb-1"></label>
                                    <input asp-for="NewPrescription.Items[i].Dose" class="form-control mr-input" />
                                    <span asp-validation-for="NewPrescription.Items[i].Dose" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="NewPrescription.Items[i].Frequency" class="form-label small mb-1"></label>
                                    <select asp-for="NewPrescription.Items[i].Frequency" asp-items="frequencies" class="form-select mr-input"></select>
                                </div>
                                <div class="col-6">
                                    <label asp-for="NewPrescription.Items[i].DurationDays" class="form-label small mb-1"></label>
                                    <input asp-for="NewPrescription.Items[i].DurationDays" type="number" min="1" max="365" class="form-control mr-input" />
                                    <span asp-validation-for="NewPrescription.Items[i].DurationDays" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="NewPrescription.Items[i].Timing" class="form-label small mb-1"></label>
                                    <input asp-for="NewPrescription.Items[i].Timing" class="form-control mr-input" placeholder="after breakfast" />
                                </div>
                                <div class="col-12">
                                    <textarea asp-for="NewPrescription.Items[i].Instructions" class="form-control mr-input" rows="2" placeholder="Instructions (one per line)"></textarea>
                                </div>
                            </div>
                        </fieldset>
                    }
                </div>

                <button type="button" class="btn btn-sm mr-btn-ghost w-100 mb-3" id="rxAddItem"><i class="bi bi-plus-lg me-1"></i>Add medication</button>

                <div class="mb-3">
                    <label asp-for="NewPrescription.Notes" class="form-label small">Notes for the patient <span class="mr-muted">(optional)</span></label>
                    <textarea asp-for="NewPrescription.Notes" class="form-control mr-input" rows="2"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" name="submitAction" value="draft" class="btn mr-btn-ghost flex-fill">Save draft</button>
                    <button type="submit" name="submitAction" value="send" class="btn mr-btn-primary flex-fill"><i class="bi bi-send me-1"></i>Send to patient</button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
