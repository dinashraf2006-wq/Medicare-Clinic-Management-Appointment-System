@model MediCare.Web.Controllers.CreateDoctorInput
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create doctor account";
}
<section class="card p-4 mx-auto" style="max-width: 42rem">
    <h1 class="h3 mb-3">Create doctor account</h1>
    @if (TempData["SpecializationMessage"] is string message)
    {
        <p class="alert alert-info">@message</p>
    }
    <form asp-action="Create" method="post" class="d-grid gap-3">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control" /></div>
        <div><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
        <div><label asp-for="Password" class="form-label">Initial password</label><input asp-for="Password" class="form-control" autocomplete="new-password" /></div>
        <div><label asp-for="City" class="form-label">City</label><input asp-for="City" class="form-control" /></div>
        <div><label asp-for="SpecializationId" class="form-label"></label><select asp-for="SpecializationId" asp-items="ViewBag.Specializations" class="form-select"><option value="">Choose a specialization</option></select></div>
        <div><label asp-for="ConsultationFee" class="form-label"></label><input asp-for="ConsultationFee" type="number" min="0" step="0.01" class="form-control" /></div>
        <div><label asp-for="Bio" class="form-label"></label><textarea asp-for="Bio" class="form-control" rows="3"></textarea></div>
        <button type="submit" class="btn btn-primary">Create doctor</button>
    </form>
    <form asp-action="AddSpecialization" method="post" class="mt-4 border-top pt-3">
        <label for="name" class="form-label">Add a specialization</label>
        <div class="input-group"><input id="name" name="name" class="form-control" required maxlength="100" /><button class="btn btn-outline-primary" type="submit">Add</button></div>
    </form>
</section>
