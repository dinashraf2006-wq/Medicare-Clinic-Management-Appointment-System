@model List<MedicationCard>
@{
    Layout = "_PatientPortalLayout";
    ViewData["Title"] = "Prescriptions";
    ViewData["ActiveNav"] = "prescriptions";
}

<div class="mr-page-header">
    <div>
        <h1 class="mr-title">Prescriptions</h1>
        <p class="mr-subtitle">Your active medications and refills.</p>
    </div>
    <div class="mr-page-actions">
        @* Delivery is not part of this phase; the button matches the design only. *@
        <button type="button" class="btn mr-btn-primary" disabled title="Coming soon"><i class="bi bi-truck me-1"></i>Order delivery</button>
    </div>
</div>

@if (Model.Count == 0)
{
    <section class="mr-card">
        <div class="mr-empty">
            <i class="bi bi-capsule"></i>
            <p class="mb-1 fw-semibold">No prescriptions yet</p>
            <p class="mr-muted small mb-0">When your doctor sends you a prescription it will appear here.</p>
        </div>
    </section>
}

<div class="row g-3">
    @foreach (var card in Model)
    {
        var item = card.Item;
        var supply = card.Supply;
        var statusText = !supply.IsActive ? "Completed" : supply.IsRefillDue ? "Refill soon" : "Active";
        var statusClass = !supply.IsActive ? "badge-status-muted" : supply.IsRefillDue ? "badge-status-warn" : "badge-status-ok";
        var barClass = supply.IsRefillDue ? "bg-warn" : "bg-ok";
        <div class="col-md-6 col-xl-4">
            <article class="mr-card mr-med-card @(supply.IsActive ? "" : "is-finished")">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <span class="mr-med-icon"><i class="bi bi-capsule"></i></span>
                    <div class="min-w-0">
                        <h2 class="h6 fw-bold mb-0 text-truncate">@item.MedicationName</h2>
                        <div class="mr-muted small">@(item.Indication ?? "Medication")</div>
                    </div>
                </div>
                <span class="mr-badge @statusClass mb-2">@statusText</span>
                <div class="small mb-1"><i class="bi bi-clock me-1 mr-muted"></i>@(item.Dose + (item.Timing is null ? "" : " · " + item.Timing))</div>
                <div class="small mb-3"><i class="bi bi-person me-1 mr-muted"></i>Prescribed by @card.Prescription.Doctor.User.FullName</div>

                <div class="d-flex justify-content-between small mr-muted mb-1">
                    <span>Supply left</span><span class="fw-semibold">@supply.PercentLeft%</span>
                </div>
                <div class="mr-progress mb-3"><div class="@barClass" style="width:@supply.PercentLeft%"></div></div>

                <div class="d-flex gap-2">
                    @* Refill requests are not part of this phase; the button matches the design only. *@
                    <button type="button" class="btn btn-sm mr-btn-soft flex-fill" disabled title="Coming soon">Request refill</button>
                    <a class="btn btn-sm mr-btn-ghost flex-fill" href="/Patient/Prescriptions/Medication/@item.Id">Details</a>
                </div>
            </article>
        </div>
    }
</div>
